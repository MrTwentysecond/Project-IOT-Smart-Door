/* Divider utama */
.auth-divider {
    display: flex; align-items: center; gap: 10px;
    margin-bottom: 18px;
    color: var(--text-m);
    font-size: 0.8rem;
    font-weight: 500;
}
.auth-divider::before,
.auth-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border-soft);
}

/*
    TOMBOL GOOGLE — utama & paling menonjol
    Background putih, teks #111827, shadow biru saat hover
*/
.auth-form-google { margin-bottom: 0; }
.btn-google-primary {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    padding: 14px 20px;
    background: #fff;
    color: #111827;
    border: none;
    border-radius: var(--r-md);
    font-family: var(--font);
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 6px 24px rgba(0,0,0,0.35);
    letter-spacing: 0.1px;
    position: relative;
    overflow: hidden;
}
.btn-google-primary::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(59,130,246,0.06), transparent);
    opacity: 0;
    transition: opacity 0.2s;
}
.btn-google-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 32px rgba(59,130,246,0.3);
}
.btn-google-primary:hover::after { opacity: 1; }
.btn-google-primary:active { transform: translateY(0); }
.google-svg { width: 22px; height: 22px; flex-shrink: 0; }
.btn-arrow {
    margin-left: auto;
    color: #6b7280;
    font-size: 1rem;
    transition: transform 0.2s;
}
.btn-google-primary:hover .btn-arrow { transform: translateX(3px); }

/* Divider sekunder */
.auth-secondary-divider {
    display: flex; align-items: center; gap: 10px;
    margin: 18px 0 14px;
    color: var(--text-m);
    font-size: 0.75rem;
    font-weight: 500;
}
.auth-secondary-divider::before,
.auth-secondary-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border-soft);
}

/*
    TOMBOL SEKUNDER — berjajar dua kolom
    Lebih kecil, warna muted, tidak berebut perhatian dengan tombol Google
*/
.auth-secondary-btns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 20px;
}
.btn-secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px 14px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: var(--r-sm);
    color: var(--text-s);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 600;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
    letter-spacing: 0.1px;
}
.btn-secondary:hover {
    background: rgba(59,130,246,0.1);
    border-color: rgba(59,130,246,0.25);
    color: var(--blue-l);
