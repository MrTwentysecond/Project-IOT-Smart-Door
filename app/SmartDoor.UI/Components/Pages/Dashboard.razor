.row-danger { background: rgba(239,68,68,0.04) !important; }

/* Empty state */
.empty-state {
    display: flex; flex-direction: column; align-items: center;
    gap: 10px; padding: 50px 20px;
    color: var(--db-text-m); text-align: center;
}
.empty-state span { font-size: 2.5rem; opacity: 0.35; }
.empty-state p { margin: 0; font-size: 0.9rem; }

/* ─── Responsive ─── */
@@media (max-width: 900px) {
    .stat-grid { grid-template-columns: 1fr 1fr; }
    .db-page { padding: 24px 16px 60px; }
    .form-grid-3 { grid-template-columns: 1fr; }
    .db-navbar { padding: 0 16px; }
}
@@media (max-width: 520px) {
    .stat-grid { grid-template-columns: 1fr; }
}
