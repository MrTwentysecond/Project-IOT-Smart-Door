.btn-delete:hover { background: rgba(239,68,68,0.2); }
.confirm-txt { font-size: 0.75rem; color: #fca5a5; font-weight: 600; }
.btn-confirm-del {
    padding: 4px 10px; background: var(--red); color: #fff;
