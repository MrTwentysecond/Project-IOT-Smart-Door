.btn-confirm-del:hover { opacity: 0.85; }
.btn-cancel-del {
    padding: 4px 8px; background: transparent; color: var(--db-text-m);
    border: 1px solid var(--db-border-s); border-radius: 7px;
    font-size: 0.78rem; cursor: pointer;
