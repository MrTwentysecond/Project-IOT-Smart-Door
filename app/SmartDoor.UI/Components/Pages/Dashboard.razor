.db-table td { padding: 12px 16px; color: var(--db-text); vertical-align: middle; }
.td-num  { color: var(--db-text-m); font-size: 0.78rem; }
.td-bold { font-weight: 600; }
.td-time { color: var(--db-text-s); font-size: 0.8rem; white-space: nowrap; }
.td-muted{ color: var(--db-text-s); font-size: 0.83rem; }
.td-aksi { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }

/* Badges */
