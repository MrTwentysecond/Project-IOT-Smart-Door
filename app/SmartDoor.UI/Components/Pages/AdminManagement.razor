@*
    AdminManagement.razor  (route: "/admin")
    ─────────────────────────────────────────────────────────────────
    Halaman CRUD (Create, Read, Update, Delete) untuk tabel ADMIN.
    
    Berdasarkan ERD — tabel ADMIN berisi:
      PK CompanyCode  → kode perusahaan/institusi
      PK id_admin     → ID unik admin
         username     → nama pengguna untuk login
         password_hash → hash password (untuk login non-Google)
    
    Halaman ini menggunakan EmptyLayout (tanpa sidebar).
    Mode: InteractiveServer (agar form & operasi CRUD bisa berjalan)
    
    Data saat ini masih MOCK (dummy) karena belum terhubung ke DB.
    ─────────────────────────────────────────────────────────────────
*@

@page "/admin"
@layout EmptyLayout

@* Mode interaktif wajib untuk event handling (klik tombol, form input) *@
@rendermode InteractiveServer

<PageTitle>Kelola Admin – SmartDoorAccess</PageTitle>

@* ══════════════ NAVBAR ══════════════ *@
<nav class="am-navbar">
    <div class="am-nav-brand">
        <a href="/" class="am-back-link">← Kembali</a>
        <div class="am-nav-logo">🔐</div>
        <span class="am-nav-title">
            <span class="c-smart">Smart</span><span class="c-door">Door</span><span class="c-access">Access</span>
            <small> / Kelola Admin</small>
        </span>
    </div>
    <div class="am-nav-right">
        @* Jam real-time di pojok kanan atas *@
        <RealtimeClock />
        <a href="/dashboard" class="am-nav-cta">Dashboard →</a>
    </div>
</nav>

<div class="am-page">

    @* ══════════════ HEADER HALAMAN ══════════════ *@
    <div class="am-header">
        <div>
            <h1 class="am-title">👤 Manajemen Admin</h1>
            <p class="am-subtitle">Kelola akun admin yang berhak mengakses sistem SmartDoorAccess</p>
        </div>
        @* Tombol Tambah Admin → tampilkan form Create *@
        <button class="btn-add" @onclick="BukaFormTambah">
            <span>＋</span> Tambah Admin
        </button>
    </div>

    @* ══════════════ PESAN NOTIFIKASI ══════════════ *@
    @* Muncul sementara setelah aksi Create/Update/Delete berhasil *@
    @if (!string.IsNullOrEmpty(_pesan))
    {
        <div class="am-alert @_pesanTipe">
            @_pesan
            <button @onclick="() => _pesan = string.Empty" class="alert-close">×</button>
        </div>
    }

    @* ══════════════ FORM CREATE / EDIT ══════════════ *@
    @*
        Form ini muncul saat:
        - Tombol "Tambah Admin" diklik  → mode Create (id = 0)
        - Tombol "Edit" di tabel diklik  → mode Update (id = id admin yg dipilih)
    *@
    @if (_tampilkanForm)
    {
        <div class="am-form-card">
            <h3 class="form-title">
                @(_formAdmin.IdAdmin == 0 ? "➕ Tambah Admin Baru" : "✏️ Edit Admin")
            </h3>

            <div class="form-grid">

                @* Input: Company Code *@
                <div class="form-group">
                    <label>Company Code <span class="required">*</span></label>
                    @* 
                        @bind → dua arah binding: 
                        nilai input ↔ properti _formAdmin.CompanyCode 
                    *@
                    <input type="text"
                           class="form-input"
                           placeholder="Contoh: UNIV001"
                           @bind="_formAdmin.CompanyCode" />
                </div>

                @* Input: Username *@
                <div class="form-group">
                    <label>Username <span class="required">*</span></label>
                    <input type="text"
                           class="form-input"
                           placeholder="Nama pengguna admin"
                           @bind="_formAdmin.Username" />
                </div>

                @* Input: Email (untuk Google login) *@
                <div class="form-group">
                    <label>Email Google <span class="required">*</span></label>
                    <input type="email"
                           class="form-input"
                           placeholder="email@gmail.com"
                           @bind="_formAdmin.Email" />
                </div>

                @* Input: Password — hanya wajib saat Create baru *@
                <div class="form-group">
                    <label>
                        Password
                        @if (_formAdmin.IdAdmin != 0)
                        {
                            @* Saat Edit, password opsional — kosong = tidak diubah *@
                            <span class="hint">(kosongkan jika tidak diubah)</span>
                        }
                        else
                        {
                            <span class="required">*</span>
                        }
                    </label>
                    <input type="password"
                           class="form-input"
                           placeholder="Minimal 8 karakter"
                           @bind="_formAdmin.PasswordInput" />
                </div>

            </div>

            @* Validasi error *@
            @if (!string.IsNullOrEmpty(_errorValidasi))
            {
                <p class="form-error">⚠️ @_errorValidasi</p>
            }

            @* Tombol aksi form *@
            <div class="form-actions">
                @* Simpan → panggil fungsi simpan (Create atau Update) *@
                <button class="btn-save" @onclick="SimpanAdmin">
                    @(_formAdmin.IdAdmin == 0 ? "💾 Simpan Admin" : "✔ Update Admin")
                </button>
                @* Batal → tutup form *@
                <button class="btn-cancel" @onclick="TutupForm">Batal</button>
            </div>
        </div>
    }

    @* ══════════════ TABEL DATA ADMIN (READ) ══════════════ *@
    <div class="am-table-card">
        <div class="am-table-header">
            <h3>📋 Daftar Admin Terdaftar</h3>
            <span class="am-badge">@_daftarAdmin.Count admin</span>
        </div>

        @if (_daftarAdmin.Count == 0)
        {
            @* Tampilan kosong jika tidak ada data *@
            <div class="empty-state">
                <span>👤</span>
                <p>Belum ada admin terdaftar</p>
                <button class="btn-add" @onclick="BukaFormTambah">Tambah Admin Pertama</button>
            </div>
        }
        else
        {
            <div class="am-table-wrapper">
                <table class="am-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>ID Admin</th>
                            <th>Company Code</th>
                            <th>Username</th>
                            <th>Email Google</th>
                            <th>Dibuat</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* Loop seluruh data admin *@
                        @foreach (var (admin, index) in _daftarAdmin.Select((a, i) => (a, i)))
                        {
                            <tr class="@(admin.IdAdmin == _idHapusKonfirmasi ? "row-danger" : "")">
                                <td class="td-num">@(index + 1)</td>
                                <td><code class="id-badge">ADM-@admin.IdAdmin.ToString("D3")</code></td>
                                <td><span class="company-badge">@admin.CompanyCode</span></td>
                                <td class="td-username">@admin.Username</td>
                                <td class="td-email">@admin.Email</td>
                                <td class="td-date">@admin.DibuatPada.ToString("dd/MM/yyyy")</td>
                                <td class="td-aksi">

                                    @* Tombol Edit → isi form dengan data admin ini *@
                                    <button class="btn-edit" @onclick="() => BukaFormEdit(admin)">✏️ Edit</button>

                                    @* Tombol Hapus / Konfirmasi Hapus *@
                                    @if (admin.IdAdmin == _idHapusKonfirmasi)
                                    {
                                        @* Minta konfirmasi sebelum benar-benar hapus *@
                                        <span class="confirm-text">Yakin hapus?</span>
                                        <button class="btn-confirm-delete" @onclick="() => HapusAdmin(admin.IdAdmin)">Ya, Hapus</button>
                                        <button class="btn-cancel-delete" @onclick="() => _idHapusKonfirmasi = -1">Batal</button>
                                    }
                                    else
                                    {
                                        <button class="btn-delete" @onclick="() => _idHapusKonfirmasi = admin.IdAdmin">🗑️ Hapus</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div> @* /.am-page *@

@code {
    // ──────────────────────────────────────────────
    // MODEL DATA ADMIN
    // Sesuai dengan tabel ADMIN di ERD
    // ──────────────────────────────────────────────
    private class AdminModel
    {
        public int    IdAdmin      { get; set; }       // PK auto-increment
        public string CompanyCode  { get; set; } = ""; // PK (dari ERD)
        public string Username     { get; set; } = ""; // Nama pengguna
        public string Email        { get; set; } = ""; // Email Google
        public string PasswordHash { get; set; } = ""; // Hash password (disimpan di DB)
        
        // Field input sementara — tidak disimpan langsung ke DB
        // Akan di-hash dulu sebelum disimpan
        public string PasswordInput { get; set; } = "";
        
        public DateTime DibuatPada { get; set; } = DateTime.Now;
    }

    // ──────────────────────────────────────────────
    // STATE KOMPONEN
    // ──────────────────────────────────────────────
    
    // List semua admin (nantinya dari database)
    private List<AdminModel> _daftarAdmin = new()
    {
        // Data mock/dummy untuk demo tampilan
        new() { IdAdmin = 1, CompanyCode = "UNIV001", Username = "ibnu_admin",  Email = "ibnu@gmail.com",   DibuatPada = DateTime.Now.AddDays(-30) },
        new() { IdAdmin = 2, CompanyCode = "UNIV001", Username = "falzen_adm",  Email = "falzen@gmail.com",  DibuatPada = DateTime.Now.AddDays(-15) },
        new() { IdAdmin = 3, CompanyCode = "UNIV002", Username = "wahyu_super", Email = "wahyu@gmail.com",   DibuatPada = DateTime.Now.AddDays(-7)  },
    };

    // Form yang sedang diisi (dipakai untuk Create & Update)
    private AdminModel _formAdmin = new();

    // Apakah form Create/Edit sedang ditampilkan?
    private bool _tampilkanForm = false;

    // ID admin yang sedang menunggu konfirmasi hapus (-1 = tidak ada)
    private int _idHapusKonfirmasi = -1;

    // Pesan notifikasi (sukses/error) + tipe CSS-nya
    private string _pesan       = string.Empty;
    private string _pesanTipe   = ""; // "alert-success" atau "alert-danger"

    // Pesan error validasi form
    private string _errorValidasi = string.Empty;

    // Counter untuk ID baru (di produksi, ini dari auto-increment DB)
    private int _nextId => _daftarAdmin.Count > 0 ? _daftarAdmin.Max(a => a.IdAdmin) + 1 : 1;

    // ──────────────────────────────────────────────
    // CREATE — Buka form kosong untuk tambah admin
    // ──────────────────────────────────────────────
    private void BukaFormTambah()
    {
        _formAdmin       = new AdminModel(); // Form kosong baru
        _errorValidasi   = string.Empty;
        _tampilkanForm   = true;
        _idHapusKonfirmasi = -1;
    }

    // ──────────────────────────────────────────────
    // UPDATE — Buka form pre-filled dengan data admin
    // ──────────────────────────────────────────────
    private void BukaFormEdit(AdminModel admin)
    {
        // Salin data admin ke form (agar tidak mengubah langsung data asli)
        _formAdmin = new AdminModel
        {
            IdAdmin     = admin.IdAdmin,
            CompanyCode = admin.CompanyCode,
            Username    = admin.Username,
            Email       = admin.Email,
            // Password tidak di-copy ke form (keamanan)
        };
        _errorValidasi = string.Empty;
        _tampilkanForm = true;
        _idHapusKonfirmasi = -1;
    }

    // ──────────────────────────────────────────────
    // SIMPAN — Menentukan Create atau Update berdasarkan IdAdmin
    // ──────────────────────────────────────────────
    private void SimpanAdmin()
    {
        // Validasi input wajib
        if (string.IsNullOrWhiteSpace(_formAdmin.CompanyCode) ||
            string.IsNullOrWhiteSpace(_formAdmin.Username)    ||
            string.IsNullOrWhiteSpace(_formAdmin.Email))
        {
            _errorValidasi = "Company Code, Username, dan Email wajib diisi.";
            return;
        }

        // Validasi password saat Create baru
        if (_formAdmin.IdAdmin == 0 && string.IsNullOrWhiteSpace(_formAdmin.PasswordInput))
        {
            _errorValidasi = "Password wajib diisi untuk admin baru.";
            return;
        }

        if (_formAdmin.IdAdmin == 0)
        {
            // ── CREATE: Tambah admin baru ──
            var adminBaru = new AdminModel
            {
                IdAdmin     = _nextId,
                CompanyCode = _formAdmin.CompanyCode.Trim(),
                Username    = _formAdmin.Username.Trim(),
                Email       = _formAdmin.Email.Trim(),
                // Di produksi: gunakan BCrypt.Net atau ASP.NET PasswordHasher
                PasswordHash = $"[hashed:{_formAdmin.PasswordInput}]",
                DibuatPada  = DateTime.Now
            };
            _daftarAdmin.Add(adminBaru);
            TampilkanPesan("✅ Admin berhasil ditambahkan!", "alert-success");
        }
        else
        {
            // ── UPDATE: Cari admin lama dan update datanya ──
            var existing = _daftarAdmin.FirstOrDefault(a => a.IdAdmin == _formAdmin.IdAdmin);
            if (existing != null)
            {
                existing.CompanyCode = _formAdmin.CompanyCode.Trim();
                existing.Username    = _formAdmin.Username.Trim();
                existing.Email       = _formAdmin.Email.Trim();
                if (!string.IsNullOrWhiteSpace(_formAdmin.PasswordInput))
                    existing.PasswordHash = $"[hashed:{_formAdmin.PasswordInput}]";
            }
            TampilkanPesan("✅ Admin berhasil diperbarui!", "alert-success");
        }

        TutupForm();
    }

    // ──────────────────────────────────────────────
    // DELETE — Hapus admin berdasarkan ID
    // ──────────────────────────────────────────────
    private void HapusAdmin(int idAdmin)
    {
        var admin = _daftarAdmin.FirstOrDefault(a => a.IdAdmin == idAdmin);
        if (admin != null)
        {
            _daftarAdmin.Remove(admin);
            TampilkanPesan($"🗑️ Admin '{admin.Username}' berhasil dihapus.", "alert-danger");
        }
        _idHapusKonfirmasi = -1;
    }

    // ──────────────────────────────────────────────
    // HELPER: Tutup form & reset state
    // ──────────────────────────────────────────────
    private void TutupForm()
    {
        _tampilkanForm = false;
        _formAdmin     = new AdminModel();
        _errorValidasi = string.Empty;
    }

    // ──────────────────────────────────────────────
    // HELPER: Tampilkan pesan notifikasi
    // ──────────────────────────────────────────────
    private void TampilkanPesan(string pesan, string tipe)
    {
        _pesan     = pesan;
        _pesanTipe = tipe;
    }
}

<style>
/* ══════════════════════════════════════════════════
   GLOBAL RESET UNTUK HALAMAN INI
   ══════════════════════════════════════════════════ */
:root {
    --bg-main:     #0a0e1a;
    --bg-card:     #141e33;
    --bg-card2:    #1a2744;
    --border:      rgba(59, 130, 246, 0.15);
    --border-soft: rgba(255, 255, 255, 0.06);
    --text-primary:   #e2e8f0;
    --text-secondary: #94a3b8;
    --text-muted:     #475569;
    --blue:    #3b82f6;
    --indigo:  #6366f1;
    --red:     #ef4444;
    --green:   #22c55e;
}

body { background: var(--bg-main); color: var(--text-primary); margin: 0; }

/* ══════════════════════════════════════════════════
   NAVBAR
   ══════════════════════════════════════════════════ */
.am-navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 40px;
    height: 64px;
    background: rgba(10, 14, 26, 0.9);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
    gap: 16px;
}
.am-nav-brand { display: flex; align-items: center; gap: 12px; }
.am-back-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.85rem;
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid var(--border-soft);
    transition: all 0.2s;
}
.am-back-link:hover { color: var(--text-primary); background: rgba(255,255,255,0.06); }
.am-nav-logo {
    font-size: 1.4rem;
    background: linear-gradient(135deg, var(--blue), var(--indigo));
    width: 36px; height: 36px;
    border-radius: 9px;
    display: flex; align-items: center; justify-content: center;
}
.am-nav-title { font-weight: 700; font-size: 1rem; }
.am-nav-title small { color: var(--text-muted); font-weight: 400; }
.c-smart { color: var(--blue); }
.c-door  { color: var(--text-primary); }
.c-access{ color: var(--indigo); }
.am-nav-right { display: flex; align-items: center; gap: 16px; }
.am-nav-cta {
    padding: 7px 18px;
    background: linear-gradient(135deg, var(--blue), var(--indigo));
    color: white;
    text-decoration: none;
    border-radius: 9px;
    font-size: 0.85rem;
    font-weight: 600;
    transition: opacity 0.2s;
}
.am-nav-cta:hover { opacity: 0.85; color: white; }

/* ══════════════════════════════════════════════════
   BODY HALAMAN
   ══════════════════════════════════════════════════ */
.am-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 32px 80px;
    font-family: 'Segoe UI', system-ui, sans-serif;
}

/* ─── Header halaman ─── */
.am-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 28px;
    gap: 16px;
}
.am-title {
    font-size: 1.9rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 6px;
}
.am-subtitle { color: var(--text-secondary); font-size: 0.92rem; margin: 0; }

/* ─── Tombol Tambah ─── */
.btn-add {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    background: linear-gradient(135deg, var(--blue), var(--indigo));
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s;
    white-space: nowrap;
    box-shadow: 0 4px 20px rgba(59,130,246,0.3);
}
.btn-add:hover { opacity: 0.9; transform: translateY(-1px); }

/* ══════════════════════════════════════════════════
   NOTIFIKASI / ALERT
   ══════════════════════════════════════════════════ */
.am-alert {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 20px;
    border-radius: 12px;
    margin-bottom: 20px;
    font-size: 0.9rem;
    font-weight: 500;
    animation: slideDown 0.3s ease;
}
@@keyframes slideDown { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
.alert-success { background: rgba(34, 197, 94, 0.12); border: 1px solid rgba(34,197,94,0.3); color: #86efac; }
.alert-danger  { background: rgba(239, 68, 68, 0.12); border: 1px solid rgba(239,68,68,0.3);  color: #fca5a5; }
.alert-close { background: none; border: none; color: inherit; font-size: 1.2rem; cursor: pointer; padding: 0 4px; opacity: 0.7; }
.alert-close:hover { opacity: 1; }

/* ══════════════════════════════════════════════════
   FORM CARD (CREATE / EDIT)
   ══════════════════════════════════════════════════ */
.am-form-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 32px;
    margin-bottom: 28px;
    animation: fadeIn 0.25s ease;
}
@@keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
.form-title { color: var(--text-primary); font-size: 1.15rem; font-weight: 700; margin: 0 0 24px; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
.form-group { display: flex; flex-direction: column; gap: 7px; }
.form-group label { font-size: 0.85rem; color: var(--text-secondary); font-weight: 500; }
.required { color: var(--red); margin-left: 2px; }
.hint { color: var(--text-muted); font-weight: 400; font-size: 0.78rem; margin-left: 6px; }
.form-input {
    padding: 10px 14px;
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--border-soft);
    border-radius: 10px;
    color: var(--text-primary);
    font-size: 0.9rem;
    transition: border-color 0.2s, background 0.2s;
    outline: none;
}
.form-input:focus {
    border-color: rgba(59, 130, 246, 0.5);
    background: rgba(59, 130, 246, 0.06);
}
.form-input::placeholder { color: var(--text-muted); }
.form-error { color: #fca5a5; font-size: 0.83rem; margin: 4px 0 0; background: rgba(239,68,68,0.1); padding: 10px 14px; border-radius: 8px; border: 1px solid rgba(239,68,68,0.2); }
.form-actions { display: flex; gap: 12px; margin-top: 20px; }
.btn-save {
    padding: 10px 24px;
    background: linear-gradient(135deg, var(--blue), var(--indigo));
    color: white; border: none; border-radius: 10px;
    font-size: 0.9rem; font-weight: 600; cursor: pointer;
    transition: opacity 0.2s;
}
.btn-save:hover { opacity: 0.85; }
.btn-cancel {
    padding: 10px 20px;
    background: rgba(255,255,255,0.06);
    color: var(--text-secondary);
    border: 1px solid var(--border-soft);
    border-radius: 10px; font-size: 0.9rem; cursor: pointer;
    transition: background 0.2s;
}
.btn-cancel:hover { background: rgba(255,255,255,0.1); }

/* ══════════════════════════════════════════════════
   TABEL DATA
   ══════════════════════════════════════════════════ */
.am-table-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 20px;
    overflow: hidden;
}
.am-table-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 28px;
    border-bottom: 1px solid var(--border-soft);
}
.am-table-header h3 { margin: 0; font-size: 1rem; font-weight: 700; color: var(--text-primary); }
.am-badge {
    background: rgba(59,130,246,0.15);
    color: #93c5fd;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 20px;
    border: 1px solid rgba(59,130,246,0.25);
}
.am-table-wrapper { overflow-x: auto; }
.am-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
.am-table thead th {
    padding: 12px 16px;
    background: rgba(255,255,255,0.03);
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-bottom: 1px solid var(--border-soft);
    white-space: nowrap;
}
.am-table tbody tr {
    border-bottom: 1px solid var(--border-soft);
    transition: background 0.15s;
}
.am-table tbody tr:hover { background: rgba(255,255,255,0.03); }
.am-table tbody tr:last-child { border-bottom: none; }
.am-table td { padding: 13px 16px; color: var(--text-primary); vertical-align: middle; }
.td-num  { color: var(--text-muted); font-size: 0.8rem; }
