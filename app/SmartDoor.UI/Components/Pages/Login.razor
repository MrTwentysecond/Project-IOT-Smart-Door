@page "/login"
<PageTitle>Login - SmartDoorAccess</PageTitle>

<div style="display: flex; justify-content: center; align-items: center; height: 80vh;">
    <div style="text-align: center; padding: 40px; border: 1px solid #ccc; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
        <h2>Login ke SmartDoorAccess</h2>
        <p style="margin-bottom: 20px; color: #666;">Silakan masuk menggunakan akun Google Anda.</p>
        
        <!-- Tombol form menuju endpoint Google Authentication -->
        <form action="/signin-google" method="post">
            <button type="submit" style="padding: 12px 24px; background-color: #4285F4; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 16px; font-weight: bold;">
                Login dengan Google
            </button>
        </form>
    </div>
</div>