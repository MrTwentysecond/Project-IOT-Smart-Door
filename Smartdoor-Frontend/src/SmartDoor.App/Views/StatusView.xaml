<UserControl x:Class="SmartDoor.App.Views.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="16">
        <!-- Ibnu: ganti TextBlock ini dengan desain status pintu -->
        <TextBlock Text="{Binding Status}" FontSize="28" FontWeight="Bold"/>
        <TextBlock Text="Tap terakhir" Margin="0,16,0,4" Opacity="0.6"/>
        <!-- Ibnu: ganti ListBox ini dengan tabel log -->
        <ListBox ItemsSource="{Binding LogTerakhir}" Height="200"/>
    </StackPanel>
</UserControl>
