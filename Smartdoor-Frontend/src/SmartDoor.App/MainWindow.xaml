<Window x:Class="SmartDoor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:SmartDoor.App.Views"
        Title="Smart Door" Height="560" Width="760"
        Background="{DynamicResource AppBackground}">
    <!-- Ibnu: shell + ganti tema. Konten ganti via Screen: User/Login/Admin. -->
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12" LastChildFill="False">
            <TextBlock Text="Smart Door" FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource AppText}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <TextBlock Text="Tema:" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource AppMuted}"/>
                <Button Content="Terang" Command="{Binding SetThemeCommand}"
                        CommandParameter="Terang" Margin="0,0,4,0"/>
                <Button Content="Gelap" Command="{Binding SetThemeCommand}"
                        CommandParameter="Gelap" Margin="0,0,4,0"/>
                <Button Content="Custom" Command="{Binding SetThemeCommand}"
                        CommandParameter="Custom"/>
            </StackPanel>
        </DockPanel>
        <ContentControl x:Name="ScreenHost"/>
    </DockPanel>
</Window>
